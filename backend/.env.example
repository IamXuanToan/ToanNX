# Bật khi chạy local; production để False.
DJANGO_DEBUG=False
# Secret dùng chung cho toàn hệ thống (Django, JWT, HMAC refresh token).
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# PostgreSQL. Neon: host pooled (...-pooler...), DB_SSLMODE=require.
DB_NAME=toannx
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=0

# Danh sách host được phép truy cập backend
DJANGO_ALLOWED_HOSTS=toannx.com,www.toannx.com,api.toannx.com,toannx-backend.vercel.app,toannx-frontend.vercel.app,localhost,127.0.0.1

# Nguồn tin cậy bảo vệ CSRF (Frontend và Backend origins)
CSRF_TRUSTED_ORIGINS=https://toannx.com,https://www.toannx.com,https://toannx-frontend.vercel.app,https://api.toannx.com,https://toannx-backend.vercel.app

# Nguồn được phép gọi CORS
CORS_ALLOWED_ORIGINS=https://toannx.com,https://www.toannx.com,https://toannx-frontend.vercel.app,http://localhost:3000

AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=600
AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=604800
AUTH_LOGIN_RATE_LIMIT=10
LOG_LEVEL=INFO

# Cấu hình gửi email (SMTP/production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.toannx.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@toannx.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=TOANNX <info@toannx.com>
PASSWORD_RESET_TIMEOUT=900
# Gửi mail bất đồng bộ (tránh block request)
EMAIL_ASYNC=True

# ==============================================================================
# CLOUDFLARE R2 STORAGE (Object Storage cho Upload Ảnh / Media - Zero Egress Fees)
# Để trống khi chạy dev cục bộ dùng FileSystem (media/)
# ==============================================================================
# FILE_STORAGE_BACKEND=app.core.storage.r2_storage.R2Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=toannx-media
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.toannx.com
CLOUDFLARE_R2_ENDPOINT_URL=

# Bí mật Vercel Cron gửi khi gọi GET /api/v1/health/cleanup (rỗng = tắt endpoint).
CRON_SECRET=
# Hạn giữ trước khi dọn: journal (ngày), file của tệp đã xóa mềm và file mồ côi (ngày).
JOURNAL_RETENTION_DAYS=365
ATTACHMENT_PURGE_DAYS=30
# Báo lỗi lên Sentry (rỗng = tắt).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
