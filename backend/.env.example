# Bật khi chạy local; production để False.
DJANGO_DEBUG=False
# Secret dùng chung cho toàn hệ thống (Django, JWT, HMAC refresh token).
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# PostgreSQL. Neon: host pooled (...-pooler...), DB_SSLMODE=require.
DB_NAME=toannx
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=0
DJANGO_ALLOWED_HOSTS=toannx.com,api.toannx.com
CSRF_TRUSTED_ORIGINS=https://toannx.com
CORS_ALLOWED_ORIGINS=
AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=600
AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=604800
AUTH_LOGIN_RATE_LIMIT=10
LOG_LEVEL=INFO
# Cấu hình gửi email (SMTP/production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=nxtoan2k4@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=TOANNX <no-reply@toannx.com>
PASSWORD_RESET_TIMEOUT=900
# Gửi mail bất đồng bộ (tránh block request)
EMAIL_ASYNC=True
# Origin frontend được lấy động theo request header (Origin / Referer / Host), không cần hardcode
# Bí mật Vercel Cron gửi khi gọi GET /api/v1/health/cleanup (rỗng = tắt endpoint).
CRON_SECRET=
# Hạn giữ trước khi dọn: journal (ngày), file của tệp đã xóa mềm và file mồ côi (ngày).
JOURNAL_RETENTION_DAYS=365
ATTACHMENT_PURGE_DAYS=30
# Báo lỗi lên Sentry (rỗng = tắt).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
