# ==============================================================================================================
# BACKEND — MẪU ĐỦ MỌI BIẾN (không chứa bí mật thật). Local: chép thành `.env.local`; production: `.env`.
# Có `.env.local` thì chỉ đọc file đó (không gộp với `.env`).
# ==============================================================================================================

# ---------------- DJANGO ----------------
# Bật chế độ debug. Local: True. Production: False (bắt buộc).
DJANGO_DEBUG=False

# Khóa bí mật gốc của hệ thống: session/CSRF, ký access JWT, HMAC refresh token, mã hóa
# SecretCipher. Sinh: `uv run python -c "import secrets; print(secrets.token_urlsafe(50))"`. Đổi giá trị = mọi
# phiên đăng nhập và bí mật đã mã hóa (token SePay/Telegram trong DB) mất hiệu lực. Không bao giờ để trống.
DJANGO_SECRET_KEY=

# Host được phép (phân tách dấu phẩy). Local: localhost,127.0.0.1. Production: domain API + web.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origin frontend được gửi request có cookie (phân tách dấu phẩy, có scheme). DEBUG=True tự thêm
# localhost:3000/3001.
CSRF_TRUSTED_ORIGINS=http://localhost:3001

# Origin được gọi API khác domain (CORS). Production: https://toannx.com,https://www.toannx.com. Local DEBUG tự thêm localhost.
CORS_ALLOWED_ORIGINS=https://toannx.com,https://www.toannx.com

# Domain cho cookie session_hint (để frontend toannx.com đọc được cờ phiên từ api.toannx.com).
# Production: .toannx.com (có dấu chấm đầu). Local: để trống.
AUTH_COOKIE_DOMAIN=

# URL frontend dự phòng khi dựng link trong email mà không có request (link đặt lại mật khẩu...).
FRONTEND_URL=http://localhost:3001

# Mức log: DEBUG / INFO / WARNING / ERROR / CRITICAL. Để trống: INFO khi DEBUG=True, WARNING khi production; tách stdout (INFO) và stderr (WARNING/ERROR).
LOG_LEVEL=INFO

# ---------------- DATABASE (PostgreSQL) ----------------
# Chuỗi kết nối PostgreSQL. Local + test: PostgreSQL trên máy (test tự tạo DB `test_toannx`, chạy
# trên DB cloud sẽ bị chặn). Production: chuỗi Neon/Postgres cloud (`?sslmode=require`). Bắt buộc.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toannx

# Ghi đè tên DB trong DATABASE_URL (E2E dùng `toannx_e2e`). Để trống: theo DATABASE_URL.
DB_NAME=

# Giữ kết nối DB (giây). 0 = đóng sau mỗi request (hợp serverless/Vercel, pgbouncer).
DB_CONN_MAX_AGE=0

# Giới hạn thời gian một câu SQL (ms). Mặc định 5000.
DB_STATEMENT_TIMEOUT_MS=5000

# Chờ kết nối PostgreSQL tối đa N giây (Neon đang ngủ cần vài giây để thức; tránh treo khi mạng lỗi). Mặc định 10.
DB_CONNECT_TIMEOUT=10

# Hạn mức dung lượng database (byte). Neon free: 1 GB/project (ghi vượt bị từ chối). Cron dọn dẹp hằng ngày
# cảnh báo trong chuông + email khi dùng từ 80%. Để 0: tắt cảnh báo. Mặc định 1073741824 (1 GB).
DATABASE_MAX_BYTES=1073741824

# Redis (Upstash, gói free: 500.000 lệnh/tháng, 256 MB) dùng làm cache + bộ đếm rate limit.
# Lấy ở Vercel → Storage → Upstash for Redis (integration tự tạo `REDIS_URL`, dạng
# `rediss://default:<mật khẩu>@<host>.upstash.io:6379`), hoặc console.upstash.com → database → TCP.
# Để trống (local, pytest): không cache công khai, rate limit đếm bằng PostgreSQL. Redis lỗi hoặc hết hạn mức
# lệnh cũng tự về dự phòng này, không trả 500. Dùng cho: cache link rút gọn/trang công khai, bộ đếm rate
# limit, mốc "có thông báo chờ gửi" (cron không đánh thức Neon khi không có việc).
REDIS_URL=

# ---------------- UPSTASH QSTASH (gửi thông báo ngầm) ----------------
# Request chỉ ghi outbox thông báo; QStash gọi lại POST /api/v1/system/notifications/dispatch ở lượt function riêng
# (ngay hoặc hẹn trễ cho lần thử lại). Gói free 1.000 tin/ngày. Lấy ở Vercel → Storage → Upstash QStash
# (integration tự tạo các biến dưới) hoặc console.upstash.com → QStash.
# Để trống QSTASH_TOKEN: không đá QStash, chỉ còn cron ngoài (cron-job.org) gửi thông báo.
# URL API QStash theo region (Vercel integration tạo sẵn). Mặc định https://qstash.upstash.io.
QSTASH_URL=
# Token đăng tin (bí mật).
QSTASH_TOKEN=
# Hai khóa ký để kiểm chữ ký `Upstash-Signature` của lượt gọi lại (bí mật; có cả hai để xoay khóa không gián đoạn).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------- XÁC THỰC ----------------
# Thời hạn access JWT (giây). Mặc định 600 (10 phút).
AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=600

# Thời hạn refresh token (giây). Mặc định 604800 (7 ngày).
AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# Số lần đăng nhập sai tối đa mỗi 15 phút / IP. Mặc định 10.
AUTH_LOGIN_RATE_LIMIT=10

# Phiên/refresh token hết hạn quá số ngày này thì bị dọn. Mặc định 30.
AUTH_EXPIRED_RETENTION_DAYS=30

# Hạn link đặt lại mật khẩu (giây). Mặc định 900 (15 phút).
PASSWORD_RESET_TIMEOUT=900

# ---------------- ĐĂNG NHẬP GOOGLE / GITHUB (OAuth) ----------------
# Lấy ở Google Cloud Console → APIs & Services → Credentials (docs/guides/oauth.md).
# Để trống: tắt đăng nhập Google.
GOOGLE_OAUTH_CLIENT_ID=

# Client secret của Google OAuth (bí mật).
GOOGLE_OAUTH_CLIENT_SECRET=

# Lấy ở GitHub → Settings → Developer settings → OAuth Apps. Để trống: tắt đăng nhập GitHub.
GITHUB_OAUTH_CLIENT_ID=

# Client secret của GitHub OAuth (bí mật).
GITHUB_OAUTH_CLIENT_SECRET=

# ---------------- EMAIL ----------------
# Local: django.core.mail.backends.console.EmailBackend (in email ra terminal, không gửi thật).
# Production: django.core.mail.backends.smtp.EmailBackend. Để trống: console khi DEBUG, SMTP khi không.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Máy chủ SMTP (production).
EMAIL_HOST=

# Cổng SMTP: 587 (TLS) hoặc 465 (SSL).
EMAIL_PORT=587

# Tài khoản SMTP.
EMAIL_HOST_USER=

# Mật khẩu SMTP (bí mật).
EMAIL_HOST_PASSWORD=

# Dùng STARTTLS (cổng 587).
EMAIL_USE_TLS=True

# Dùng SSL (cổng 465). Không bật cùng TLS.
EMAIL_USE_SSL=False

# Timeout kết nối SMTP (giây). Mặc định 5 (chặn treo khi SMTP chậm).
EMAIL_TIMEOUT=5

# Địa chỉ gửi đi.
DEFAULT_FROM_EMAIL=ToanNX <no-reply@toannx.com>

# Gửi email theo mẫu (quên mật khẩu, xác minh, lời mời) ở luồng nền. Mặc định False: trên Vercel luồng
# nền có thể bị dừng sau khi trả response làm mất thư. Chỉ bật khi chạy server lâu dài.
EMAIL_ASYNC=False

# ---------------- FILE / CLOUDFLARE R2 ----------------
# Local/test: django.core.files.storage.FileSystemStorage (lưu `backend/media`, KHÔNG gọi R2 —
# R2 gói miễn phí có giới hạn lượt gọi). Production: app.core.storage.r2_storage.R2Storage.
FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# Account ID Cloudflare (dashboard → R2 → Overview). Chỉ production. Xem docs/guides/cloudflare-r2.md.
CLOUDFLARE_R2_ACCOUNT_ID=

# R2 → Manage R2 API Tokens → Access Key ID (bí mật).
CLOUDFLARE_R2_ACCESS_KEY_ID=

# R2 API token → Secret Access Key (bí mật).
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Bucket công khai (ảnh đại diện, ảnh trang...). Để trống: không dùng R2.
CLOUDFLARE_R2_BUCKET_NAME=

# Bucket riêng tư KHÔNG bật public access (chứng từ, hóa đơn). Dùng R2 mà để trống thì upload
# file riêng tư bị từ chối.
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=

# Domain công khai gắn với bucket công khai (ví dụ media.toannx.com).
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Endpoint S3 của R2: https://<account_id>.r2.cloudflarestorage.com.
CLOUDFLARE_R2_ENDPOINT_URL=

# API token Cloudflare quyền Account → R2 Storage → Read, để đo dung lượng thật của 2 bucket.
# Để trống: tính dung lượng từ DB. Test luôn tắt (backend/conftest.py).
CLOUDFLARE_API_TOKEN=

# Dung lượng tối đa một file (byte). Mặc định 5242880 (5 MB).
ATTACHMENT_MAX_SIZE_BYTES=5242880

# Tổng dung lượng tối đa cả 2 bucket (byte). Mặc định 9 GB (R2 miễn phí 10 GB).
ATTACHMENT_MAX_TOTAL_STORAGE_BYTES=9663676416

# Hạn link ký tới file riêng tư (giây). Mặc định 300.
ATTACHMENT_PRIVATE_URL_TTL_SECONDS=300

# File đã xóa mềm / mồ côi bị dọn khỏi storage sau số ngày này. Mặc định 30.
ATTACHMENT_PURGE_DAYS=30

# Giới hạn body request không tính file (byte). Mặc định 1048576.
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576

# ---------------- THÔNG BÁO (Firebase Web Push) ----------------
# Project ID Firebase (console.firebase.google.com). Thiếu một trong hai biến Firebase thì kênh
# PUSH bị ẩn. Xem docs/guides/notification-setup.md.
FIREBASE_PROJECT_ID=

# Service account JSON (Project settings → Service accounts → Generate key) mã hóa base64
# (bí mật).
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=


# ---------------- TÀI CHÍNH (SePay) ----------------
# sandbox (local/test) hoặc production. Token SePay của từng người lưu mã hóa trong DB, không ở env.
SEPAY_ENV=sandbox

# ---------------- DỌN DẸP / CRON ----------------
# Header bí mật Vercel Cron gửi khi gọi /api/v1/system/health/cleanup, gửi thông báo tồn và cron Workspace.
# Sinh ngẫu nhiên (bí mật). Để trống: tắt các endpoint cron.
CRON_SECRET=

# ---------------- TELEGRAM BOT CHUNG ----------------
# Token Bot Telegram chung toàn hệ thống lấy từ @BotFather (bí mật). Để trống: tắt kênh Telegram và bot trợ lý.
TELEGRAM_BOT_TOKEN=

# Username của Bot Telegram chung (không kèm ký tự @). Để trống: hệ thống tự lấy qua API getMe rồi cache Redis.
TELEGRAM_BOT_USERNAME=

# ---------------- TRỢ LÝ AI (xKiro OpenAI-compatible) ----------------
# URL API OpenAI-compatible cho Trợ lý AI cá nhân (VD https://api.xkiro.example). Để trống: chỉ chạy lệnh Slash 0 token.
XKIRO_API_BASE=

# API key xác thực tới xKiro (bí mật). Để trống: tắt gọi LLM.
XKIRO_API_KEY=

# Model AI ưu tiên mặc định số 1 (VD gpt-4o-mini).
XKIRO_MODEL=

# Danh sách model AI dự phòng khi gặp 429/402/5xx/timeout, phân tách bằng dấu phẩy theo thứ tự ưu tiên.
XKIRO_FALLBACK_MODELS=

# Timeout mỗi lượt gọi chat AI tính bằng giây (khoảng 1..60). Mặc định 10.
XKIRO_TIMEOUT_SECONDS=10

# Timeout chờ/đọc stream cho tác vụ viết bài dài (Tiptap AI) tính bằng giây (khoảng 5..120). Mặc định 35.
XKIRO_COMPOSE_TIMEOUT_SECONDS=35

# Thời gian (giây) tạm né model đang lỗi trong Redis để fallback tức thì. Mặc định 120.
XKIRO_COOLDOWN_SECONDS=120

# API key Google Gemini (lấy tại Google AI Studio, bí mật) để nhúng vector trí nhớ Trợ lý AI vào pgvector.
# Để trống: tắt tìm theo nghĩa, Trợ lý chỉ dùng tìm kiếm full-text PostgreSQL. Gói free: Google có thể dùng nội dung gửi lên.
GEMINI_API_KEY=

# Model embedding Gemini (trả 768 chiều qua outputDimensionality). Đổi model: hệ thống tự nhúng lại dần. Mặc định gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Giữ lịch sử thay đổi bao nhiêu ngày. Mặc định 365.
JOURNAL_RETENTION_DAYS=365

# ---------------- TIỆN ÍCH ----------------
# Host nội bộ (link rút gọn trỏ về đây không cần kiểm tra an toàn).
SHORT_LINK_INTERNAL_HOSTS=toannx.com,www.toannx.com,localhost

# Số link rút gọn tối đa mỗi người. Mặc định 500.
SHORT_LINK_MAX_PER_OWNER=500

# Số mã QR tối đa mỗi người. Mặc định 200.
QR_CODE_MAX_PER_OWNER=200

# Số trang tùy chỉnh tối đa mỗi người. Mặc định 50.
CUSTOM_PAGE_MAX_PER_OWNER=50

# Dung lượng nội dung Tiptap tối đa một trang (byte). Mặc định 262144.
CUSTOM_PAGE_CONTENT_MAX_BYTES=262144

# Số ảnh tối đa một trang. Mặc định 30.
CUSTOM_PAGE_MAX_IMAGES=30

# Số video tối đa một trang. Mặc định 10.
CUSTOM_PAGE_MAX_VIDEOS=10

# ---------------- RATE LIMIT (số lần trong cửa sổ khai ở settings.RATE_LIMITS) ----------------
# Bật giới hạn tần suất (bucket PostgreSQL). Mặc định True.
RATE_LIMIT_ENABLED=True

# Ghi mặc định / người / phút.
RL_DEFAULT_WRITE=300

# Đọc API công khai / IP / phút.
RL_PUBLIC_READ=120

# Yêu cầu quên mật khẩu / IP / 15 phút.
RL_AUTH_PASSWORD_RESET_REQUEST=5

# Kiểm tra link đặt lại mật khẩu / IP / 15 phút.
RL_AUTH_PASSWORD_RESET_VALIDATE=30

# Đặt lại mật khẩu / IP / 15 phút.
RL_AUTH_PASSWORD_RESET_CONFIRM=10

# Gửi email xác minh / người / 5 phút.
RL_EMAIL_VERIFICATION_SEND=5

# Xác minh email / IP / 15 phút.
RL_EMAIL_VERIFICATION_VERIFY=30

# Kiểm tra lời mời / IP / 15 phút.
RL_INVITATION_VALIDATE=30

# Nhận lời mời / IP / 15 phút.
RL_INVITATION_ACCEPT=10

# Đăng nhập mạng xã hội / IP / 15 phút.
RL_SOCIAL_AUTH=30

# Liên kết mạng xã hội / người / 15 phút.
RL_SOCIAL_LINK=10

# Gỡ liên kết mạng xã hội / người / 15 phút.
RL_SOCIAL_UNLINK=10

# Tạo link rút gọn / người / giờ.
RL_SHORT_LINK_CREATE=30

# Mở link có mật khẩu / IP / phút.
RL_SHORT_LINK_UNLOCK=10

# Tạo trang / người / giờ.
RL_PAGE_CREATE=20

# Tạo đường dẫn trang / người / giờ.
RL_PAGE_PATH_CREATE=10

# Tạo mã QR / người / giờ.
RL_QR_CREATE=60

# Xem trước mã QR / người / phút.
RL_QR_PREVIEW=120

# Gửi góp ý ẩn danh từ trang công khai / IP / phút (mặc định 5).
RL_FEEDBACK_SUBMIT=5

# Báo lỗi phía client / IP / phút.
RL_CLIENT_ERROR=30

# Mở file riêng tư / người / phút.
RL_ATTACHMENT_CONTENT=120

# Gọi API SePay / người / phút.
RL_SEPAY_CALL=10

# Webhook SePay / IP / phút.
RL_SEPAY_WEBHOOK=120

# Gọi API Telegram / người / phút.
RL_TELEGRAM_CALL=20

# Webhook Telegram gọi về hệ thống / IP / phút.
RL_TELEGRAM_WEBHOOK=120

# Tạo truyện / người / giờ.
RL_NOVEL_CREATE=60

# Import truyện / người / giờ.
RL_NOVEL_IMPORT=10

# ---------------- E2E (chỉ khi chạy Playwright: manage.py prepare_e2e) ----------------
# Email tài khoản E2E. Để trống: e2e-admin@toannx.local.
E2E_EMAIL=

# Mật khẩu tài khoản E2E (chỉ dùng cho DB toannx_e2e).
E2E_PASSWORD=
