#!/usr/bin/env sh
# Kiểm tra dòng đầu commit theo docs/rules/git.md: <type>(<scope>)!: <mo-ta>
msg_file="$1"
first_line=$(head -n 1 "$msg_file" | tr -d '\r')

case "$first_line" in
  Merge\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

pattern='^(feat|fix|ref|docs|test|perf|style|build|ci|chore|revert)(\([a-z0-9][a-z0-9-]*\))?!?: [^A-Z].+[^.]$'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message sai chuẩn (docs/rules/git.md)." >&2
  echo "  Mẫu: <type>(<scope>): <mo-ta>   vd: feat(short-links): add public redirects" >&2
  echo "  Type: feat fix ref docs test perf style build ci chore revert" >&2
  echo "  Nhận được: $first_line" >&2
  exit 1
fi

if [ "${#first_line}" -gt 72 ]; then
  echo "Dòng đầu commit dài ${#first_line} ký tự (tối đa 72)." >&2
  exit 1
fi
