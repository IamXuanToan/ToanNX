# ==============================================================================================================
# FRONTEND — MẪU ĐỦ MỌI BIẾN. Local: chép thành `.env.local`; production: `.env` / biến của Vercel.
# ==============================================================================================================

# ---------------- KẾT NỐI ----------------
# Origin của Django API; Next rewrite /api/v1/* sang đây (chỉ phía server). Local: http://localhost:8001
# (scripts/dev.bat). Production: https://api.toannx.com.
BACKEND_ORIGIN=http://localhost:8001

# URL công khai của web (SEO, link tuyệt đối, cookie Secure khi https). Local: http://localhost:3001.
# Production: https://toannx.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------- THÔNG BÁO TRÌNH DUYỆT (Firebase web) ----------------
# console.firebase.google.com → Project settings → General → Your apps (Web). Giá trị công khai.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Project ID Firebase. Để trống: tắt thông báo trình duyệt.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Sender ID (Project settings → Cloud Messaging).
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# App ID web.
NEXT_PUBLIC_FIREBASE_APP_ID=

# VAPID public key: Cloud Messaging → Web Push certificates → Generate key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------- PHÂN TÍCH ----------------
# Website ID Umami (cloud.umami.is). Để trống: tắt (local nên để trống để không lẫn số liệu).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
