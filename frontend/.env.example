# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (ToanNX)
# ==============================================================================

# Origin của Django API (dùng phía server trong Next.js rewrites: /api/v1/*)
# Development local: http://localhost:8001
# Production / Staging:
# BACKEND_ORIGIN=https://api.toannx.com
# BACKEND_ORIGIN=https://toannx-backend.vercel.app
BACKEND_ORIGIN=http://localhost:8001

# URL công khai của Frontend
# Development local: http://localhost:3001
# Production: https://toannx.com (hoặc https://www.toannx.com)
# Staging / Preview: https://toannx-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Domain lưu trữ Cloudflare R2 Media (CDN)
NEXT_PUBLIC_MEDIA_URL=https://media.toannx.com
